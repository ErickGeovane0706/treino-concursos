{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Bash(cat *.env)",
      "Bash(cat */.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guarda.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
