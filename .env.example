# Docker Compose (desenvolvimento: docker-compose.yml | producao: docker-compose.prod.yml)
# Copie para .env e preencha. Nunca versione o arquivo .env.
DB_NAME=treino_concursos
DB_USERNAME=treino
DB_PASSWORD=
DB_PORT=5432

# --- Variaveis adicionais exigidas em PRODUCAO (docker-compose.prod.yml) ---
SITE_URL=https://www.seudominio.com.br
CONTATO_EMAIL=
CONTATO_RESPONSAVEL=
ADMIN_INICIAL_EMAIL=
ADMIN_INICIAL_SENHA=

# Publicidade (manter false ate ter 200-300 questoes e a conta AdSense aprovada)
ADS_ENABLED=false
ADSENSE_PUBLISHER_ID=
ADSENSE_SLOT_QUESTAO=
ADSENSE_SLOT_LATERAL=

# Backup diario (pg_dump + retencao de 30 dias + copia externa S3 / Cloudflare R2)
BACKUP_RETENCAO_DIAS=30
BACKUP_CRON=0 3 * * *
BACKUP_S3_PROVIDER=Cloudflare
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIXO=treino-concursos
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
